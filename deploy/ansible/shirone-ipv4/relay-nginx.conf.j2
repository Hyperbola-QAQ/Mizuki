worker_processes 1;
pid {{ shirone_relay_runtime }}/nginx.pid;
error_log stderr warn;
events { worker_connections 1024; }
http {
    access_log off;
    client_body_temp_path {{ shirone_relay_runtime }}/client_body;
    proxy_temp_path {{ shirone_relay_runtime }}/proxy;
    map $http_upgrade $shirone_upgrade_connection {
        default upgrade;
        "" close;
    }
    map "$ssl_server_name:$host" $shirone_host_allowed {
        default 0;
{% for host in shirone_relay_hostnames %}
        "{{ host }}:{{ host }}" 1;
{% endfor %}
    }
    server {
        listen {{ shirone_relay_listen }} ssl default_server;
        server_name _;
        ssl_reject_handshake on;
    }
    server {
        listen {{ shirone_relay_listen }} ssl;
        server_name {{ shirone_relay_hostnames | join(' ') }};
        ssl_certificate {{ shirone_relay_cert }};
        ssl_certificate_key {{ shirone_relay_key }};
        ssl_client_certificate {{ shirone_relay_client_ca }};
        ssl_verify_client on;
        ssl_protocols TLSv1.2 TLSv1.3;
        if ($shirone_host_allowed = 0) { return 421; }
        client_max_body_size {{ shirone_relay_body_limit | default('100m') }};
        location / {
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $shirone_upgrade_connection;
            proxy_ssl_server_name on;
            proxy_ssl_name $ssl_server_name;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate {{ shirone_relay_origin_ca }};
            proxy_ssl_verify_depth 5;
            proxy_connect_timeout 5s;
            proxy_read_timeout 120s;
            proxy_pass https://{{ shirone_relay_upstream }};
        }
    }
}
